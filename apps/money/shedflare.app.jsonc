{
  "$schema": "../../packages/cli/schemas/app-manifest-schema.json",
  "id": "money",
  "name": "Shedflare Money",
  "description": "Simple monthly budgeting ledger",
  "dependsOn": ["auth"],
  "defaultSubdomain": "money",
  "vars": {
    "APP_PUBLIC_URL": {
      "from": "appUrl",
      "description": "Public URL of this money app",
    },
    "AUTH_ISSUER_URL": {
      "from": "appUrl",
      "app": "auth",
      "description": "Auth issuer URL",
    },
    "AUTH_CLIENT_ID": {
      "from": "appId",
      "description": "OAuth client ID for this app",
    },
    "OWNER_EMAIL": {
      "from": "ownerEmail",
      "description": "Deployment owner email",
    },
  },
  "secrets": {},
  "resources": [
    {
      "type": "d1",
      "binding": "DB",
      "name": "shedflare-money",
      "idField": "DB_ID",
    },
  ],
}
