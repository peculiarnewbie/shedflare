{
  "$schema": "../../packages/shedflare-core/schemas/app-manifest.schema.json",
  "id": "routines",
  "name": "Shedflare Routines",
  "description": "Daily routine tracker with progress visualization",
  "lifecycle": "experimental",
  "category": "productivity",
  "dataSensitivity": "personal",
  "dependsOn": ["auth"],
  "defaultSubdomain": "routines",
  "vars": {
    "APP_PUBLIC_URL": {
      "from": "appUrl",
      "description": "Public URL of this routines app",
    },
    "AUTH_ISSUER_URL": {
      "from": "appUrl",
      "app": "auth",
      "description": "Auth issuer URL",
    },
    "AUTH_CLIENT_ID": {
      "from": "appId",
      "description": "OAuth client ID for this app",
    },
    "OWNER_EMAIL": {
      "from": "ownerEmail",
      "description": "Deployment owner email",
    },
  },
  "secrets": {},
  "resources": [
    {
      "type": "d1",
      "binding": "DB",
      "name": "shedflare-routines",
      "idField": "DB_ID",
    },
  ],
}
