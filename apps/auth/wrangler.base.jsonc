{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shedflare-auth",
  "main": "src/worker.ts",
  "compatibility_date": "2026-03-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "kv_namespaces": [
    {
      "binding": "OPENAUTH_STORAGE",
    },
  ],
}
