{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shedflare-auth",
  "main": "src/worker.ts",
  "compatibility_date": "2026-03-22",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_PUBLIC_URL": "https://auth.peculiarnewbie.com",
    "GOOGLE_CLIENT_ID": "1061674839158-p3tt2pckrha5ipvg9bgkf81d8j8u3gpi.apps.googleusercontent.com",
    "OWNER_EMAIL": "peculiarnewbie@gmail.com",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "kv_namespaces": [
    {
      "binding": "OPENAUTH_STORAGE",
      "id": "1acd6625d3e04096bf33080aedf00d71",
    },
  ],
  "routes": [
    {
      "pattern": "auth.peculiarnewbie.com",
      "custom_domain": true,
    },
  ],
}
