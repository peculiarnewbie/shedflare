{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shedflare-drive",
  "main": "src/worker.ts",
  "compatibility_date": "2026-03-22",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
  },
  "vars": {
    "APP_PUBLIC_URL": "https://drive.peculiarnewbie.com",
    "AUTH_ISSUER_URL": "https://auth.peculiarnewbie.com",
    "AUTH_CLIENT_ID": "shedflare-drive",
    "OWNER_EMAIL": "peculiarnewbie@gmail.com",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shedflare-drive",
      "database_id": "dcea2933-735e-4970-a4c5-e85d176a09b4",
      "remote": true,
    },
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "shedflare-drive-files",
      "remote": true,
    },
  ],
  "routes": [
    {
      "pattern": "drive.peculiarnewbie.com",
      "custom_domain": true,
    },
  ],
}
