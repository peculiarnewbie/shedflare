{
  "name": "@shedflare/drive",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "test": "vp test",
    "test:e2e": "vp exec jiti e2e.run.ts",
    "check": "vp check src alchemy.run.ts vite.config.ts worker-configuration.d.ts",
    "typecheck": "tsc --noEmit",
    "deploy": "vp exec alchemy deploy alchemy.run.ts",
    "destroy": "vp exec alchemy destroy alchemy.run.ts",
    "db:migrate": "wrangler d1 migrations apply shedflare-drive --remote",
    "prepare": "vp config"
  },
  "dependencies": {
    "@shedflare/auth-client": "workspace:*",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^0.15.4",
    "drizzle-orm": "catalog:",
    "solid-js": "^1.9.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.32.3",
    "@cloudflare/workers-types": "^4.20260415.1",
    "@playwright/test": "^1.60.0",
    "@shedflare/test-utils": "workspace:*",
    "@solidjs/testing-library": "^0.8.0",
    "@typescript/native-preview": "catalog:",
    "drizzle-kit": "catalog:",
    "jsdom": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "^2.11.12",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  },
  "engines": { "node": ">=22.12.0" },
  "packageManager": "pnpm@10.32.1",
  "cloudflare": {
    "bindings": {
      "APP_PUBLIC_URL": { "description": "The canonical public URL of the app." },
      "OWNER_EMAIL": { "description": "Required owner email..." },
      "AUTH_ISSUER_URL": { "description": "Canonical public URL of the central Shedflare Auth issuer." },
      "AUTH_CLIENT_ID": { "description": "OAuth client ID used by this app when talking to Shedflare Auth." },
      "DEV_AUTH_EMAIL": { "description": "Optional local-only development identity used on localhost." }
    }
  }
}
