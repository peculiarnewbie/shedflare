{
  "name": "@shedflare/anki",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "test": "vp test --passWithNoTests",
    "check": "vp check src alchemy.run.ts vite.config.ts",
    "typecheck": "tsc --noEmit",
    "deploy": "vp exec alchemy deploy alchemy.run.ts --stage prod",
    "destroy": "vp exec alchemy destroy alchemy.run.ts --stage prod",
    "prepare": "vp config"
  },
  "dependencies": {
    "@shedflare/auth-client": "workspace:*",
    "@solidjs/meta": "^0.29.4",
    "drizzle-orm": "catalog:",
    "solid-js": "^1.9.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.32.3",
    "@cloudflare/workers-types": "^4.20260415.1",
    "@typescript/native-preview": "catalog:",
    "drizzle-kit": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "^2.11.12",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.9.0",
  "cloudflare": {
    "bindings": {
      "APP_PUBLIC_URL": {
        "description": "The canonical public URL of the app."
      },
      "OWNER_EMAIL": {
        "description": "Deployment owner email."
      },
      "AUTH_ISSUER_URL": {
        "description": "Canonical public URL of Shedflare Auth."
      },
      "AUTH_CLIENT_ID": {
        "description": "OAuth client ID used by this app."
      },
      "DEV_AUTH_EMAIL": {
        "description": "Optional local-only development identity used on localhost."
      }
    }
  }
}
