{
  "name": "@shedflare/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "check": "vp check src test vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vp test",
    "registry:generate": "vp exec jiti scripts/generate-registry.ts",
    "registry:check": "vp exec jiti scripts/generate-registry.ts --check",
    "schemas:generate": "vp exec jiti scripts/generate-schemas.ts",
    "schemas:check": "vp exec jiti scripts/generate-schemas.ts --check",
    "contract:check": "vp exec jiti scripts/check-contract.ts",
    "generate": "pnpm registry:generate && pnpm schemas:generate"
  },
  "dependencies": {
    "@valibot/to-json-schema": "^1.7.1",
    "jsonc-parser": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
