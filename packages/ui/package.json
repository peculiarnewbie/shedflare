{
  "name": "@shedflare/ui",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shedflare/shedflare.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "sideEffects": [
    "dist/tokenami.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./css": "./src/css.ts",
    "./theme": "./src/theme.ts",
    "./config": "./src/config.ts",
    "./tokenami.css": "./dist/tokenami.css"
  },
  "scripts": {
    "build": "tokenami --config .tokenami/tokenami.config.ts --output dist/tokenami.css",
    "build:watch": "tokenami --config .tokenami/tokenami.config.ts --output dist/tokenami.css --watch",
    "dev": "vp dev",
    "predev": "pnpm run build",
    "test": "vp test",
    "pretest": "pnpm run build",
    "check": "vp fmt src dev .tokenami vite.config.ts && tokenami check --config .tokenami/tokenami.config.ts",
    "typecheck": "vp check --no-fmt --no-lint && tokenami check --config .tokenami/tokenami.config.ts"
  },
  "dependencies": {
    "@tokenami/css": "catalog:"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.0",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "jsdom": "catalog:",
    "solid-js": "^1.9.12",
    "tokenami": "catalog:",
    "typescript": "^5.9.3",
    "vite-plugin-solid": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
