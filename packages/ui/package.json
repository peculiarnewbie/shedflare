{
  "name": "@shedflare/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "dist/tokenami.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./css": "./src/css.ts",
    "./theme": "./src/theme/index.ts",
    "./config": "./.tokenami/tokenami.config.ts",
    "./tokenami.css": "./dist/tokenami.css"
  },
  "scripts": {
    "build": "tokenami --config .tokenami/tokenami.config.ts --output dist/tokenami.css",
    "build:watch": "tokenami --config .tokenami/tokenami.config.ts --output dist/tokenami.css --watch",
    "check": "vp fmt src .tokenami && tokenami check --config .tokenami/tokenami.config.ts",
    "typecheck": "tokenami check --config .tokenami/tokenami.config.ts"
  },
  "dependencies": {
    "@tokenami/css": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "solid-js": "^1.9.12",
    "tokenami": "catalog:",
    "typescript": "^5.9.3",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
