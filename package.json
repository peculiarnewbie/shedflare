{
  "name": "shedflare",
  "version": "0.0.0",
  "private": true,
  "description": "A self-hosted Cloudflare app suite for personal productivity tools.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev:auth": "pnpm --filter @shedflare/auth dev",
    "dev:chat": "pnpm --filter @shedflare/chat dev",
    "dev:drive": "pnpm --filter @shedflare/drive dev",
    "dev:money": "pnpm --filter @shedflare/money dev",
    "site:dev": "pnpm --filter @shedflare/site dev",
    "site:build": "pnpm --filter @shedflare/site build",
    "site:deploy": "vp exec alchemy deploy site/alchemy.run.ts",
    "site:destroy": "vp exec alchemy destroy site/alchemy.run.ts",
    "deploy:auth": "vp exec alchemy deploy apps/auth/alchemy.run.ts",
    "destroy:auth": "vp exec alchemy destroy apps/auth/alchemy.run.ts",
    "deploy:cf-bill": "vp exec alchemy deploy apps/cf-bill/alchemy.run.ts",
    "destroy:cf-bill": "vp exec alchemy destroy apps/cf-bill/alchemy.run.ts",
    "deploy:drive": "vp exec alchemy deploy apps/drive/alchemy.run.ts",
    "destroy:drive": "vp exec alchemy destroy apps/drive/alchemy.run.ts",
    "deploy:chat": "vp build apps/chat && vp exec alchemy deploy apps/chat/alchemy.run.ts --yes",
    "destroy:chat": "vp exec alchemy destroy apps/chat/alchemy.run.ts",
    "deploy:money": "vp exec alchemy deploy apps/money/alchemy.run.ts --yes",
    "destroy:money": "vp exec alchemy destroy apps/money/alchemy.run.ts",
    "deploy:youtube": "vp exec alchemy deploy apps/youtube/alchemy.run.ts",
    "destroy:youtube": "vp exec alchemy destroy apps/youtube/alchemy.run.ts",
    "deploy:observability": "vp exec alchemy deploy apps/observability/alchemy.run.ts",
    "destroy:observability": "vp exec alchemy destroy apps/observability/alchemy.run.ts",
    "deploy:s": "vp exec alchemy deploy apps/s/alchemy.run.ts --yes",
    "destroy:s": "vp exec alchemy destroy apps/s/alchemy.run.ts",
    "deploy": "vp exec alchemy deploy alchemy.run.ts",
    "destroy": "vp exec alchemy destroy alchemy.run.ts",
    "test:auth": "SHEDFLARE_LIVE_ALCHEMY_TESTS=1 vp exec vitest run apps/auth/alchemy.test.ts",
    "test:cf-bill": "SHEDFLARE_LIVE_ALCHEMY_TESTS=1 vp exec vitest run apps/cf-bill/alchemy.test.ts",
    "test:drive": "SHEDFLARE_LIVE_ALCHEMY_TESTS=1 vp exec vitest run apps/drive/alchemy.test.ts",
    "test:e2e:drive": "vp exec jiti apps/drive/e2e.run.ts",
    "test:e2e:drive:destroy": "vp exec jiti apps/drive/e2e.run.ts --destroy-only",
    "test:chat": "SHEDFLARE_LIVE_ALCHEMY_TESTS=1 vp exec vitest run apps/chat/alchemy.test.ts",
    "test:money": "SHEDFLARE_LIVE_ALCHEMY_TESTS=1 vp exec vitest run apps/money/alchemy.test.ts",
    "test:youtube": "SHEDFLARE_LIVE_ALCHEMY_TESTS=1 vp exec vitest run apps/youtube/alchemy.test.ts",
    "test:s": "SHEDFLARE_LIVE_ALCHEMY_TESTS=1 vp exec vitest run apps/s/alchemy.test.ts",
    "cli:init": "pnpm --filter shedflare exec shedflare init --yes --mock-resources",
    "cli:doctor": "pnpm --filter shedflare exec shedflare doctor",
    "cli:check": "node packages/cli/dist/index.mjs configure --check",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm -r check && pnpm cli:check",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@shedflare/alchemy": "workspace:*",
    "@types/node": "catalog:",
    "alchemy": "catalog:",
    "effect": "catalog:",
    "jiti": "catalog:",
    "jsonc-parser": "catalog:",
    "playwright": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.32.1"
}
