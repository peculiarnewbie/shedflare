{
  "name": "shedflare",
  "version": "0.0.0",
  "private": true,
  "description": "A self-hosted Cloudflare app suite for personal productivity tools.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev:chat": "pnpm --filter @shedflare/chat dev",
    "build:chat": "pnpm --filter @shedflare/chat build",
    "deploy:chat": "pnpm --filter @shedflare/chat deploy",
    "dev:auth": "pnpm --filter @shedflare/auth dev",
    "deploy:auth": "pnpm --filter @shedflare/auth deploy",
    "deploy:auth:alchemy": "vp exec alchemy deploy apps/auth/alchemy.run.ts",
    "destroy:auth:alchemy": "vp exec alchemy destroy apps/auth/alchemy.run.ts",
    "deploy:drive:alchemy": "vp exec alchemy deploy apps/drive/alchemy.run.ts",
    "destroy:drive:alchemy": "vp exec alchemy destroy apps/drive/alchemy.run.ts",
    "deploy:chat:alchemy": "vp exec alchemy deploy apps/chat/alchemy.run.ts",
    "destroy:chat:alchemy": "vp exec alchemy destroy apps/chat/alchemy.run.ts",
    "deploy:money:alchemy": "vp exec alchemy deploy apps/money/alchemy.run.ts",
    "destroy:money:alchemy": "vp exec alchemy destroy apps/money/alchemy.run.ts",
    "deploy:alchemy": "vp exec alchemy deploy alchemy.run.ts",
    "destroy:alchemy": "vp exec alchemy destroy alchemy.run.ts",
    "test:alchemy:auth": "SHEDFLARE_LIVE_ALCHEMY_TESTS=1 vp exec vitest run apps/auth/alchemy.test.ts",
    "test:alchemy:drive": "SHEDFLARE_LIVE_ALCHEMY_TESTS=1 vp exec vitest run apps/drive/alchemy.test.ts",
    "test:alchemy:chat": "SHEDFLARE_LIVE_ALCHEMY_TESTS=1 vp exec vitest run apps/chat/alchemy.test.ts",
    "test:alchemy:money": "SHEDFLARE_LIVE_ALCHEMY_TESTS=1 vp exec vitest run apps/money/alchemy.test.ts",
    "deploy:youtube:alchemy": "vp exec alchemy deploy apps/youtube/alchemy.run.ts",
    "destroy:youtube:alchemy": "vp exec alchemy destroy apps/youtube/alchemy.run.ts",
    "test:alchemy:youtube": "SHEDFLARE_LIVE_ALCHEMY_TESTS=1 vp exec vitest run apps/youtube/alchemy.test.ts",
    "dev:drive": "pnpm --filter @shedflare/drive dev",
    "build:drive": "pnpm --filter @shedflare/drive build",
    "deploy:drive": "pnpm --filter @shedflare/drive deploy",
    "dev:money": "pnpm --filter @shedflare/money dev",
    "build:money": "pnpm --filter @shedflare/money build",
    "deploy:money": "pnpm --filter @shedflare/money deploy",
    "cli:init": "pnpm --filter shedflare exec shedflare init --yes --mock-resources",
    "cli:doctor": "pnpm --filter shedflare exec shedflare doctor",
    "cli:check": "pnpm --filter shedflare exec shedflare configure --check",
    "check": "pnpm -r check && pnpm cli:check",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@types/node": "catalog:",
    "alchemy": "catalog:",
    "effect": "catalog:",
    "jsonc-parser": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.32.1"
}
