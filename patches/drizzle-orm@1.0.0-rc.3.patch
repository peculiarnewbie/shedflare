# PATCH: Lazily initialise bufferSchema to avoid ReferenceError in browser.
#
# drizzle-orm/effect-schema/column.js evaluates Schema.instanceOf(Buffer) at
# module level.  Buffer is a Node.js global not available in the browser.
# The `bufferSchema` is only used downstream when a Drizzle column has type
# "buffer" (blob).  Since no app in this repo uses blob columns, the guard
# never fires — it just prevents the crash at module-load time.
#
# When upgrading drizzle-orm, check if this upstream bug is fixed:
#   https://github.com/drizzle-team/drizzle-orm/issues (search "bufferSchema")
# If so, delete this patch and the patchedDependencies entry in package.json.
diff --git a/effect-schema/column.js b/effect-schema/column.js
index 2574944e1b089187dbf4e3acb42fa99e52674dfd..b8cd79e033761e592c8c39cde258646fa649659b 100644
--- a/effect-schema/column.js
+++ b/effect-schema/column.js
@@ -16,7 +16,7 @@ const jsonSchema = Schema.Union([
 	Schema.Record(Schema.String, Schema.Any),
 	Schema.Array(Schema.Any)
 ]);
-const bufferSchema = Schema.instanceOf(Buffer);
+const bufferSchema = typeof Buffer !== "undefined" ? Schema.instanceOf(Buffer) : null;
 function columnToSchema(column) {
 	let schema;
 	const dimensions = column.dimensions;
