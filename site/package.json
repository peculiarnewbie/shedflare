{
  "name": "@shedflare/site",
  "version": "0.1.0",
  "private": true,
  "description": "The public Shedflare project website.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shedflare/shedflare.git",
    "directory": "site"
  },
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "test": "vp test --passWithNoTests",
    "check": "vp check src alchemy.run.ts vite.config.ts",
    "typecheck": "vp check --no-fmt --no-lint",
    "plan": "vp build && pnpm --dir .. exec alchemy plan site/alchemy.run.ts",
    "deploy": "pnpm --dir .. site:deploy",
    "deploy:stage": "vp build && pnpm --dir .. exec alchemy deploy site/alchemy.run.ts --yes",
    "destroy": "pnpm --dir .. site:destroy",
    "destroy:stage": "pnpm --dir .. exec alchemy destroy site/alchemy.run.ts --yes",
    "lint": "vp lint . --max-warnings=0"
  },
  "dependencies": {
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^0.15.4",
    "solid-js": "^1.9.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@shedflare/alchemy": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "alchemy": "catalog:",
    "effect": "catalog:",
    "jsdom": "catalog:",
    "jsonc-parser": "catalog:",
    "valibot": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
